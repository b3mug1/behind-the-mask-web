# Copy to .env.local for local development. Never commit real values.
# In Vercel, add the same names under Project Settings -> Environment Variables.
# Do NOT prefix these with VITE_ (that would expose them to the browser).

# Supabase project URL, e.g. https://YOUR-PROJECT-REF.supabase.co
SUPABASE_URL=

# Server-side secret key from Supabase (Project Settings -> API Keys).
# Used only by api/feedback.ts and scripts/feedback-report.mjs. Never ship it to the browser.
SUPABASE_SECRET_KEY=
